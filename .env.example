# Spotify Developer Dashboard → your app → Client ID
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=

# Must also add Redirect URI (exact): http://127.0.0.1:8888/callback
# Dev mode: allowlist your Spotify account under Users

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# SMOKE_TRACK_URI=spotify:track:0VjIjW4GlUZAMYd2vXMi3b
