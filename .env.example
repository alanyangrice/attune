# Copy to .env (gitignored). Keys are case-insensitive; the loader upper-cases them.
ANTHROPIC_API_KEY=                  # required for `npm run loop` (real Claude). Not needed for loop:fake
PRESAGE_API_KEY=                    # SmartSpectra, from https://physiology.presagetech.com/ (SMARTSPECTRA_API_KEY also accepted)
SPOTIFY_CLIENT_ID=                  # Spotify dev app — https://developer.spotify.com/dashboard
ELEVENLABS_API_KEY=                 # optional: spoken nudges via ElevenLabs (else macOS `say`)
# ELEVENLABS_VOICE_ID=              # default George (JBFqnCBsd6RMkjVDRZzb)

# Spotify redirect URI (exact): http://127.0.0.1:8888/callback
# Dev mode: allowlist your Spotify account under Users
# SPOTIFY=stub|real                 # default stub; real = desktop Spotify Web API
# VITALS=mock|real                  # default mock; real = SmartSpectra over the camera

# ATTUNE_MODE=demo|real             # timing profile (default demo)
# ATTUNE_MODEL=claude-opus-5        # deliberation model
# ATTUNE_FAKE_LLM=1                 # scripted policy instead of Claude
# ATTUNE_SAY=1                      # enable the say_nudge tool
